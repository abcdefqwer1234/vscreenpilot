{
  "tools": [
    {
      "name": "assert_region",
      "description": "区域断言：颜色覆盖率、与上一帧相比是否变化。changed 默认引用同区域最近一次 capture_screen；也可传 expectation.baseline_frame_id。baseline=last_same_region（默认）或 last 时断言未变化。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "expectation": {
            "type": "object",
            "description": "color/changed/baseline_frame_id/baseline=last_same_region|last"
          }
        },
        "required": [
          "region",
          "expectation"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture_screen",
      "description": "截取虚拟屏（或虚拟屏内的指定区域），返回 Base64 PNG。区域越界会被拒绝。save_path 只允许工作目录/临时目录下的 .png，且不会覆盖已有文件；meta.baseline 使用未缩放的源尺寸。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1
          },
          "save_path": {
            "type": "string",
            "description": "仅工作目录或系统临时目录内的 .png"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "click",
      "description": "在虚拟桌面坐标点击。默认不移动系统光标（UIA/窗口消息）；input 模式才使用 SendInput。坐标必须属于本会话应用，越界/其他窗口会被拒绝。Chromium/Electron/WinUI 会忽略窗口消息点击，此时返回 E_INPUT_UNSUPPORTED，请显式用 mode=input。keep_foreground=true 会暂停焦点护栏 30s，到期自动恢复。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "clicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "uia",
              "message",
              "input"
            ],
            "description": "默认 auto：UIA → 窗口消息，绝不移动光标；input 显式接受光标跳变"
          },
          "keep_foreground": {
            "type": "boolean",
            "description": "默认 false；true 时不归还用户前台，便于连续操作菜单"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "find_element",
      "description": "用 UI Automation 查找控件，返回精简的 element_ref、边界与状态（省略 runtime_id 等诊断字段）。reference 用于 invoke_element / set_element_value / get_ui_tree 的 root。默认只查最后一个存活应用，可用 pid 指定。role=document_body 可映射 Word 正文（automation_id=Body）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "name_match": {
            "type": "string",
            "enum": [
              "exact",
              "contains",
              "regex"
            ],
            "description": "默认 exact"
          },
          "control_type": {
            "type": "string"
          },
          "automation_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "document",
              "document_body"
            ],
            "description": "语义别名：document_body 映射 Edit + Body"
          },
          "prefer": {
            "type": "string",
            "enum": [
              "auto",
              "first",
              "focused",
              "largest",
              "last"
            ],
            "description": "默认 auto：焦点优先，其次面积最大"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "候选序号，默认 0"
          },
          "all": {
            "type": "boolean",
            "description": "返回全部候选"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "include_offscreen": {
            "type": "boolean",
            "description": "默认 false：只返回可见控件"
          },
          "pid": {
            "type": "integer",
            "description": "可选：指定本会话内某个应用的进程号"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "gesture",
      "description": "复合鼠标动作：drag / scroll / move。默认窗口消息，不移动系统光标；Chromium/Electron/WinUI 会拒绝消息拖拽/滚轮，需显式 mode=input。目标必须属于本会话应用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "drag",
              "scroll",
              "move"
            ]
          },
          "from": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "to": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "dx": {
            "type": "integer"
          },
          "dy": {
            "type": "integer"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 20,
            "maximum": 5000
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "message",
              "input"
            ],
            "description": "默认 auto/message：窗口消息，不移动光标；input 显式接受光标跳变"
          }
        },
        "required": [
          "type"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_element_text",
      "description": "读取文本控件的正文：优先 TextPattern（Word 正文），其次 ValuePattern。用于写值/输入后的可靠校验。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536,
            "description": "默认 4096"
          }
        },
        "required": [
          "ref"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_environment",
      "description": "查看虚拟屏、显示器、前台窗口与会话状态。foreground 只在本会话窗口位于前台时返回标题/PID，避免泄露用户主屏窗口信息。session.isolation=shared_desktop 表示与用户共享桌面、不是沙箱。ensure=true 时先修复/挂载虚拟屏。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ensure": {
            "type": "boolean",
            "description": "默认 false；true 时先 EnsureEnvironment"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_log",
      "description": "读取近期日志与最后错误。source=memory 读当前进程；file 读日志文件（重启后仍可取证）；both 同时返回。可按 level/contains 过滤。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "source": {
            "type": "string",
            "enum": [
              "memory",
              "file",
              "both"
            ],
            "description": "默认 memory"
          },
          "level": {
            "type": "string",
            "description": "可选：INFO/WARN/ERROR"
          },
          "contains": {
            "type": "string",
            "description": "可选：消息子串过滤"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_ui_tree",
      "description": "读取当前会话窗口的裁剪语义树；默认只保留交互控件，超出节点/时间预算时返回 truncated。节点带 element_ref。interactive_only=false 时仍会剪掉滚动条/分隔条等噪声。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "max_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "默认 3"
          },
          "interactive_only": {
            "type": "boolean",
            "description": "默认 true"
          },
          "max_nodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000,
            "description": "默认 300"
          },
          "root": {
            "type": "string",
            "description": "可选：以某个 element_ref 为子树根"
          },
          "pid": {
            "type": "integer",
            "description": "可选：指定本会话内某个应用的进程号"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "invoke_element",
      "description": "按 element_ref 触发控件。默认 auto 依次尝试 Invoke/Toggle/SelectionItem/ExpandCollapse/Legacy；可用 pattern 显式指定。不移动光标；无可用模式时返回 E_PATTERN_UNSUPPORTED。UIA Invoke 超过 5s 会返回 E_TIMEOUT（常见于会打开模态框的按钮），服务端会切换到新的 UIA 实例。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "auto",
              "invoke",
              "toggle",
              "select",
              "expand",
              "legacy",
              "default"
            ],
            "description": "默认 auto；default 表示聚焦后发送 Space+Enter/Enter（用于树节点打开）"
          },
          "allow_click": {
            "type": "boolean",
            "description": "默认 false；true 时允许回退为控件中心的消息点击（仍不移动光标）"
          }
        },
        "required": [
          "ref"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "launch_or_place_app",
      "description": "启动应用或接管窗口，移动到虚拟屏并最大化。默认 new_instance=true：优先独立实例/新窗口（Edge 使用独立临时配置）。Word 默认 ensure_document=true：启动后用 Ctrl+N 确保有文档。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "应用可执行文件路径"
          },
          "window": {
            "type": "string",
            "description": "按窗口标题接管（会忽略 new_instance）"
          },
          "args": {
            "type": "string"
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          },
          "new_instance": {
            "type": "boolean",
            "description": "默认 true：独立实例/新窗口；false：接管已运行窗口"
          },
          "ensure_document": {
            "type": "boolean",
            "description": "仅 Word：默认 true，无文档时自动 Ctrl+N"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "match_visual",
      "description": "像素定位：color 找颜色连通区域，pixel 取单点颜色，template 用 Base64 PNG 或 target_path 模板匹配。只读取虚拟屏，越界会被拒绝。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "template",
              "color",
              "pixel"
            ]
          },
          "target": {
            "description": "color: \"#RRGGBB\"；pixel: {x,y}；template: Base64 PNG"
          },
          "target_path": {
            "type": "string",
            "description": "template 可选：工作目录/临时目录下的 .png 文件"
          },
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "color 容差，默认 16"
          },
          "threshold": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 1,
            "description": "template 阈值，默认 0.88"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "min_pixels": {
            "type": "integer",
            "minimum": 1,
            "description": "color 最小连通像素数，默认 4"
          },
          "max_area_ratio": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1,
            "description": "color 连通域最大面积占比，默认 1.0（不过滤）"
          },
          "exclude_border": {
            "type": "boolean",
            "description": "color 是否丢弃接触区域边缘的连通域，默认 false"
          },
          "require_unique": {
            "type": "boolean",
            "description": "template 命中多个位置时返回 E_MULTIPLE_MATCHES，默认 false"
          }
        },
        "required": [
          "mode"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "press_keys",
      "description": "发送按键或组合键，例如 Ctrl+Shift+S。sequence 可在一次前台租约内发送多个按键（菜单导航）；keep_foreground=true 时保留目标焦点 30s。Win+*/Alt+Tab/Ctrl+Esc 等系统级组合默认拒绝，需 allow_system_keys=true。多应用会话可用 pid 指定目标。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "string"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "按顺序发送，例如 [\"Alt+D\",\"Down\",\"Enter\"]"
          },
          "keep_foreground": {
            "type": "boolean",
            "description": "默认 false；true 时保留目标焦点"
          },
          "allow_system_keys": {
            "type": "boolean",
            "description": "默认 false；Win+*/Alt+Tab/Ctrl+Esc 等系统级组合会被拒绝"
          },
          "pid": {
            "type": "integer",
            "description": "可选：指定本会话内某个应用的进程号"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "release_environment",
      "description": "结束调试：窗口复原、关闭本会话启动的应用。默认保留虚拟屏（会话级常驻）；on_dirty 控制未保存内容：force/discard/save/abort。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keep_display": {
            "type": "boolean",
            "description": "默认 true：保留虚拟屏到宿主退出；false：立即摘屏（会再次黑屏）"
          },
          "on_dirty": {
            "type": "string",
            "enum": [
              "force",
              "discard",
              "save",
              "abort"
            ],
            "description": "默认 force：超时强杀；discard：点“不保存”；save：点“保存”；abort：保留窗口"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "run_script",
      "description": "以当前用户权限执行临时 PowerShell 脚本（超时杀进程树）。默认关闭；需以 --allow-script 或 VSP_ALLOW_SCRIPT=1 启动。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          }
        },
        "required": [
          "code"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "set_element_value",
      "description": "按 element_ref 写值。默认 ValuePattern；allow_keyboard=true 才切前台并分块键入。mode=auto 时文档类控件默认 append，普通控件 insert（insert 是整值写入，已有内容时必须 allow_destructive=true）；replace 必须显式 allow_destructive=true。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "allow_keyboard": {
            "type": "boolean",
            "description": "默认 false"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "append",
              "insert",
              "replace"
            ],
            "description": "默认 auto：文档 append，普通控件 insert"
          },
          "allow_destructive": {
            "type": "boolean",
            "description": "默认 false；insert 覆盖非空内容或 replace 时必须为 true"
          }
        },
        "required": [
          "ref",
          "value"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "type_text",
      "description": "向当前焦点输入文本，支持非 ASCII。默认 32 字符分块并用 TextPattern/ValuePattern 回读确认；verify=false 改为一次写入的快速路径。长文本会降低回读频率。多应用会话可用 pid 指定目标，默认最后一个存活应用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "pid": {
            "type": "integer",
            "description": "可选：指定本会话内某个应用的进程号"
          },
          "verify": {
            "type": "boolean",
            "description": "默认 true：分块回读校验；false 为一次写入的快速路径"
          },
          "chunk_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "分块字符数，默认 32"
          }
        },
        "required": [
          "text"
        ]
      },
      "outputSchema": {
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
