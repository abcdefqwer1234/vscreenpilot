    {
      "name": "click",
      "title": "Click",
      "description": "Click at virtual-desktop coordinates. channel=auto picks UIA element, message or SendInput. Non-client areas (title bar, caption buttons) and popup menus are handled explicitly. keep_foreground=true pauses the focus guard for 30s.",
