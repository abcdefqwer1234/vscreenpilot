{
  "tools": [
    {
      "name": "assert_region",
      "title": "Assert region",
      "description": "Assert color coverage or change against a baseline. An explicit baseline_frame_id must match x/y/width/height exactly; mismatch returns E_NO_BASELINE instead of comparing different areas.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "expectation"
        ],
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "expectation": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "coverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "tolerance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "changed"
                ],
                "properties": {
                  "changed": {
                    "type": "boolean"
                  },
                  "threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "baseline_frame_id": {
                    "type": "string"
                  },
                  "baseline": {
                    "type": "string",
                    "enum": [
                      "last_same_region",
                      "last"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "changed_ratio": {
            "type": [
              "number",
              "null"
            ]
          },
          "coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "baseline_frame_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    },
    {
      "name": "capture_screen",
      "title": "Capture screen",
      "description": "Capture the virtual display or a region. Returns a PNG plus meta. Large frames are also written to the session artifact directory and returned as a resource link by default (inline=true to embed). save_path must be an absolute .png under the working directory or temp.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1,
            "description": "Default 0.5 for full screen, 1 for regions."
          },
          "inline": {
            "type": "boolean",
            "description": "Embed the PNG in the MCP result. Default true for small images."
          },
          "save_path": {
            "type": "string",
            "description": "Absolute .png path under cwd or temp."
          }
        }
      },
      "outputSchema": {
        "type": "object",
