          },
          "clicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "uia",
              "message",
              "input"
            ],
            "description": "Legacy alias of channel."
          },
          "channel": {
            "type": "string",
            "enum": [
              "auto",
              "uia",
              "message",
              "input"
            ]
          },
          "keep_foreground": {
            "type": "boolean"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
