          "index": {
            "type": "integer",
            "minimum": 0
          },
          "all": {
            "type": "boolean"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "include_offscreen": {
            "type": "boolean"
          },
          "pid": {
            "type": "integer",
            "minimum": 1
