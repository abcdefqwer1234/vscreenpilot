{
  "name": "invoke_element",
  "title": "Invoke element",
  "description": "Invoke a control by ref. auto tries Invoke/Toggle/SelectionItem/ExpandCollapse/Legacy; pattern=default focuses and presses Space/Enter (useful for tree nodes).",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ref": {
        "type": "string"
      },
      "pattern": {
        "type": "string",
        "enum": [
          "auto",
          "invoke",
          "toggle",
          "select",
          "selectionitem",
          "expand",
          "expandcollapse",
          "legacy",
          "default",
          "defaultaction",
          "open"
        ]
      },
      "allow_click": {
        "type": "boolean",
        "description": "Allow message click fallback."
      },
      "allow_destructive": {
        "type": "boolean",
        "description": "Allow invoking a control classified as destructive (close/delete/clear)."
      },
      "select_text": {
        "type": "string",
        "description": "Expand the control, find a descendant list item with this exact name, and select it. Returns E_MULTIPLE_MATCHES with candidates when ambiguous."
      }
    },
    "required": [
      "ref"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "invoked": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "pattern": {
        "type": [
          "string",
          "null"
        ]
      },
      "channel": {
        "type": [
          "string",
          "null"
        ]
      },
      "verified": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "additionalProperties": true
  },
  "readOnly": false,
  "destructive": true,
  "timeoutMs": 30000,
  "policy": {
    "mutates": true,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
