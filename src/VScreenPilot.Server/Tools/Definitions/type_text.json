{
  "name": "type_text",
  "title": "Type text",
  "description": "Type text into the focused control. auto uses a pattern write, clipboard paste for long text, or SendInput as fallback; verify=true reads back through TextPattern/ValuePattern.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "text": {
        "type": "string"
      },
      "pid": {
        "type": "integer",
        "minimum": 1
      },
      "hwnd": {
        "type": "integer",
        "minimum": 1,
        "description": "Target a specific tracked top-level window (for example a dialog). Must belong to a tracked app; the window is brought to the foreground before typing."
      },
      "target": {
        "type": "string",
        "enum": [
          "app",
          "current_dialog",
          "foreground"
        ],
        "description": "Default app. current_dialog resolves the active modal/owned dialog on every call, so a changing hwnd does not need to be looked up manually."
      },
      "verify": {
        "type": "boolean"
      },
      "strict_verify": {
        "type": "boolean",
        "description": "Default false. When true, return E_VERIFY_FAILED if the text cannot be read back through TextPattern/ValuePattern."
      },
      "pace_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2000,
        "description": "Default 0. Sleep between chunks (ms). Self-drawn grids that drop characters often need chunk_chars=1 with pace_ms=15-30."
      },
      "chunk_chars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 256,
        "description": "Chunk size in characters; default 32."
      },
      "channel": {
        "type": "string",
        "enum": [
          "auto",
          "pattern",
          "clipboard",
          "keys"
        ]
      }
    },
    "required": [
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "typed": {
        "type": [
          "integer",
          "null"
        ]
      },
      "verified": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "channel": {
        "type": [
          "string",
          "null"
        ]
      },
      "inject_ms": {
        "type": [
          "number",
          "null"
        ]
      },
      "duration_ms": {
        "type": [
          "number",
          "null"
        ]
      },
      "observed_length": {
        "type": [
          "integer",
          "null"
        ]
      },
      "chunks": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "additionalProperties": true
  },
  "readOnly": false,
  "destructive": true,
  "timeoutMs": 120000,
  "policy": {
    "mutates": true,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
