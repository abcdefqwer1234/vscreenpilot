{
  "name": "read_screen_text",
  "title": "Read screen text (OCR)",
  "description": "OCR the virtual display or a region with the built-in Windows OCR engine. Use it for canvas apps (PowerPoint, charts, games) where UIA exposes no text. Optional query filters lines by substring.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "query": {
        "type": "string"
      },
      "max_lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "engine": {
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "type": [
          "string",
          "null"
        ]
      },
      "lines": {
        "type": [
          "array",
          "null"
        ],
        "items": {}
      },
      "matches": {
        "type": [
          "array",
          "null"
        ],
        "items": {}
      },
      "count": {
        "type": [
          "integer",
          "null"
        ]
      },
      "returned": {
        "type": [
          "integer",
          "null"
        ]
      },
      "truncated": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "region": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      },
      "duration_ms": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "additionalProperties": true
  },
  "readOnly": true,
  "destructive": false,
  "timeoutMs": 60000,
  "policy": {
    "mutates": false,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
