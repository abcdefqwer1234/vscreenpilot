{
  "name": "read_screen_text",
  "title": "Read screen text (OCR)",
  "description": "OCR the virtual display or a region with the built-in Windows OCR engine. Use it for canvas apps (PowerPoint, charts, games) where UIA exposes no text. Optional query filters lines by substring.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "query": {
        "type": "string"
      },
      "max_lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "upscale": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4,
        "description": "Default 0 (auto): 2x/3x/4x for small regions before OCR. 1 disables; 2-4 force the factor. Coordinates are mapped back to screen pixels."
      },
      "on_out_of_bounds": {
        "type": "string",
        "enum": [
          "clip",
          "error"
        ],
        "description": "Default clip: intersect the region with the virtual display and return clipped=true. error restores E_OUT_OF_BOUNDS."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "engine": {
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "type": [
          "string",
          "null"
        ]
      },
      "lines": {
        "type": [
          "array",
          "null"
        ],
        "items": {}
      },
      "matches": {
        "type": [
          "array",
          "null"
        ],
        "items": {}
      },
      "count": {
        "type": [
          "integer",
          "null"
        ]
      },
      "returned": {
        "type": [
          "integer",
          "null"
        ]
      },
      "truncated": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "region": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      },
      "duration_ms": {
        "type": [
          "number",
          "null"
        ]
      },
      "upscale": {
        "type": [
          "integer",
          "null"
        ]
      },
      "clipped": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "ocr_source_width": {
        "type": [
          "integer",
          "null"
        ]
      },
      "ocr_source_height": {
        "type": [
          "integer",
          "null"
        ]
      },
      "ocr_scaled_width": {
        "type": [
          "integer",
          "null"
        ]
      },
      "ocr_scaled_height": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "additionalProperties": true
  },
  "readOnly": true,
  "destructive": false,
  "timeoutMs": 60000,
  "policy": {
    "mutates": false,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
