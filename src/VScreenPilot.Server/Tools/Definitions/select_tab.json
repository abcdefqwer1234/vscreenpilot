{
  "name": "select_tab",
  "title": "Select tab",
  "description": "Select a tab by name using UIA SelectionItemPattern/Invoke. Falls back to clicking the tab center. Use this instead of coordinate clicks near tab close buttons.",
  "inputSchema": {
    "type": "object",
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "name_match": {
        "type": "string",
        "enum": [
          "exact",
          "contains",
          "regex"
        ]
      },
      "index": {
        "type": "integer",
        "minimum": 0
      },
      "pid": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": [
          "string",
          "null"
        ]
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "closed": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "method": {
        "type": [
          "string",
          "null"
        ]
      },
      "bounds": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "readOnly": false,
  "destructive": false,
  "timeoutMs": 15000,
  "policy": {
    "mutates": true,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
