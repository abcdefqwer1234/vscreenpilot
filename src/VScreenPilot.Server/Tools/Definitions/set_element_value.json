{
  "name": "set_element_value",
  "title": "Set value",
  "description": "Write a value by ref. ValuePattern first; allow_keyboard=true falls back to typing. Overwriting non-empty content requires allow_destructive=true.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ref": {
        "type": "string"
      },
      "value": {
        "type": "string"
      },
      "allow_keyboard": {
        "type": "boolean"
      },
      "mode": {
        "type": "string",
        "enum": [
          "auto",
          "append",
          "insert",
          "replace"
        ]
      },
      "allow_destructive": {
        "type": "boolean"
      },
      "strict_verify": {
        "type": "boolean",
        "description": "Default false. When true, return E_VERIFY_FAILED if the value cannot be read back after writing."
      }
    },
    "required": [
      "ref",
      "value"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "written": {
        "type": [
          "string",
          "null"
        ]
      },
      "value": {
        "type": [
          "string",
          "null"
        ]
      },
      "mode": {
        "type": [
          "string",
          "null"
        ]
      },
      "verified": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "observed_length": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "additionalProperties": true
  },
  "readOnly": false,
  "destructive": true,
  "timeoutMs": 30000,
  "policy": {
    "mutates": true,
    "lease": "Always",
    "sessionRead": true,
    "sessionWrite": false,
    "bypassWriteLock": false,
    "writeTimeoutMs": 30000
  }
}
