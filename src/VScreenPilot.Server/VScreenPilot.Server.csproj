<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VScreenPilot</AssemblyName>
    <RootNamespace>VScreenPilot</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Native AOT 与 Interop.UIAutomationClient 不兼容（ILC 判定 coclass 构造函数
      为 invalid IL，Marshal.GetTypedObjectForIUnknown 在 AOT 下也不可用）。
      改用 self-contained + ReadyToRun 单文件：启动 ~73ms、空闲 ~34MB，UIA 可用。
    -->
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 分发：winget/npm 走原生 exe。dotnet tool(PackAsTool) 不支持 net10.0-windows，
         所以 dnx 入口需要单独的原生包，见 docs/audit/06。 -->
    <PackageId>VScreenPilot.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>VScreenPilot</Authors>
    <Description>Virtual-display MCP server for Windows desktop automation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VScreenPilot.Core\VScreenPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VScreenPilot.Tests" />
  </ItemGroup>

</Project>
