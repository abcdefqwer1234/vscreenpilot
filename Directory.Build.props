<Project>

  <!-- 全仓库统一构建基线：SDK 由 global.json 固定，分析器与确定性构建在此开启。 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- latest-recommended 比 minimum 多出的规则已逐条处理（CA1305/CA1001/CA2201/CA1711）；
         CA1838 是 P/Invoke 使用 StringBuilder 的既定签名，保留并在此说明理由。 -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1822/CA1859 是风格建议；CA1838 见上。CA1806 不再整体关闭，P/Invoke 返回值必须显式检查。 -->
    <NoWarn>$(NoWarn);CA1822;CA1859;CA1838</NoWarn>
  </PropertyGroup>

</Project>
