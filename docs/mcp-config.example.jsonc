{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode V2 配置片段：把 VScreenPilot 作为本地 stdio MCP Server 接入。
  // 安装版默认路径（用户名按实际替换）：
  //   C:\Users\<you>\AppData\Local\Programs\VScreenPilot\VScreenPilot.exe
  // 绿色版/源码构建则指向解压目录。
  // 合并到 ~/.config/opencode/opencode.jsonc 的 mcp.servers。
  // codemode=false：capture_screen 返回 image content，直接暴露工具以确保图片进入模型上下文。
  "mcp": {
    "servers": {
      "vscreenpilot": {
        "type": "local",
        "command": [
          "E:\\path\\to\\VScreenPilot\\artifacts\\server\\VScreenPilot.exe"
        ],
        // 需要 run_script 时，用下面这行替换上面的 command：
        // "command": ["E:\\path\\to\\VScreenPilot\\artifacts\\server\\VScreenPilot.exe", "--allow-script"],
        "codemode": false,
        "environment": {
          // 可选：限制 launch_or_place_app 只能启动这些目录下的 exe。
          // "VSP_APP_ALLOWLIST": "C:\\Program Files\\MyApp;D:\\Tools",
          // 可选：虚拟屏尺寸/刷新率；daemon 启动时读取，改后需先停 daemon。
          // "VSP_DISPLAY_WIDTH": "1920",
          // "VSP_DISPLAY_HEIGHT": "1080",
          // "VSP_DISPLAY_REFRESH": "60",
          // 可选：允许 UIA/消息点击失败后自动降级 SendInput（会移动真实光标）。
          // "VSP_INPUT_AUTOFALLBACK": "1"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 600000
        }
      }
    }
  }
}
