{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode V2 配置片段：把 VScreenPilot 作为本地 stdio MCP Server 接入。
  // 方式 A：直接指向发布产物（把路径改成实际位置）。
  // 方式 B：npm 单包（发布后使用；本地构建先运行 scripts/build-npm.ps1）：
  //   "command": ["npx", "-y", "vscreenpilot@0.1.0"]
  // 合并到 ~/.config/opencode/opencode.jsonc 的 mcp.servers。
  // codemode=false：capture_screen 返回 image content，直接暴露工具以确保图片进入模型上下文。
  "mcp": {
    "servers": {
      "vscreenpilot": {
        "type": "local",
        "command": [
          "E:\\path\\to\\VScreenPilot\\artifacts\\server\\VScreenPilot.exe"
        ],
        // 需要 run_script 时取消下面这行注释：
        // "command": ["E:\\path\\to\\VScreenPilot\\artifacts\\server\\VScreenPilot.exe", "--allow-script"],
        "codemode": false,
        "environment": {
          // 可选：限制 launch_or_place_app 只能启动这些目录下的 exe。
          // "VSP_APP_ALLOWLIST": "C:\\Program Files\\MyApp;D:\\Tools"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 600000
        }
      }
    }
  }
}
